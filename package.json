{
  "name": "quotecraft",
  "productName": "QuoteCraft",
  "version": "1.0.0",
  "description": "Professional quote and invoice management for freelancers and small businesses",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win nsis --dir"
  },
  "author": "",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "pdfkit": "^0.15.2",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.quotecraft.app",
    "productName": "QuoteCraft",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuoteCraft",
      "uninstallDisplayName": "QuoteCraft",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}