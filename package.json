{
  "name": "quotecraft",
  "productName": "QuoteCraft",
  "version": "1.4.2",
  "description": "Professional quote and invoice management for freelancers and small businesses",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "test": "node scripts/run-all-tests.js",
    "dist": "electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --win nsis --dir"
  },
  "author": "QuoteCraft",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.15.2",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ocaict/quotecraft.git"
  },
  "build": {
    "appId": "com.quotecraft.app",
    "productName": "QuoteCraft",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.wasm"
    ],
    "publish": {
      "provider": "github",
      "owner": "ocaict",
      "repo": "quotecraft"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuoteCraft",
      "uninstallDisplayName": "QuoteCraft",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
